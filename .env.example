# Copy into atlas-credentials.env for local backend use.
# Alternatively, set these variables on your production host.
MONGODB_URI=mongodb+srv://your-cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_USERNAME=your-database-user
MONGODB_PASSWORD=your-database-password
MONGODB_DB=focus
PORT=3001
HOST=127.0.0.1
# Set only when a local reverse proxy forwards requests to Express:
# TRUST_PROXY=loopback
# Production HTTPS deployment:
# NODE_ENV=production
# If credentials are embedded in MONGODB_URI, omit username/password above.
